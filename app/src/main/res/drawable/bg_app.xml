<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/bg_top" android:endColor="@color/bg_bottom" android:type="linear" />
        </shape>
    </item>
    <!-- leve brilho azul no centro -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="60%p" android:centerX="0.5" android:centerY="0.45"
                android:startColor="#330A84FF" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
