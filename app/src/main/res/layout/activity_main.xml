<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela principal da Zuri, pensada para ficar sempre ligada num tablet:
    relógio no alto, ondas azuis no centro (toque nelas para falar),
    respostas logo abaixo e a música tocando no rodapé.
    As configurações ficam num painel separado (botão de engrenagem).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- Ondas -->
    <com.alef.assistentea.ui.WaveView
        android:id="@+id/waveView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="90dp"
        android:layout_marginBottom="200dp"
        android:clickable="true"
        android:contentDescription="@string/widget_label"
        android:focusable="true" />

    <!-- Vídeo da música (player oficial do YouTube dentro da tela da Zuri) -->
    <FrameLayout
        android:id="@+id/videoCard"
        android:layout_width="320dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:padding="2dp"
        android:visibility="invisible">

        <WebView
            android:id="@+id/youtubeWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Relógio e data -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/text"
                    android:textSize="56sp" />

                <!-- Temperatura atual (atualiza a cada 15 min) -->
                <TextView
                    android:id="@+id/weatherNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/cyan"
                    android:textSize="28sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="EEEE, d 'de' MMMM"
                android:format24Hour="EEEE, d 'de' MMMM"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/updateButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/mic_button_bg"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/update_now"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/control_bg"
            android:contentDescription="@string/settings"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Estado, o que ouviu e a resposta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="128dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="@string/status_idle"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/heardText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/replyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/cyan"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Música tocando -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        android:background="@drawable/card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_music" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nothing_playing"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/trackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/volDownButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/control_bg"
            android:contentDescription="Diminuir volume"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vol_down" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/volUpButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/control_bg"
            android:contentDescription="Aumentar volume"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vol_up" />

        <ImageButton
            android:id="@+id/prevButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/control_bg"
            android:contentDescription="Música anterior"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/mic_button_bg"
            android:contentDescription="Tocar ou pausar"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/control_bg"
            android:contentDescription="Próxima música"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/mic_button_bg"
            android:contentDescription="@string/widget_label"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

    <!-- Painel de configurações -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/settings"
                    android:textColor="@color/text"
                    android:textSize="26sp" />

                <ImageButton
                    android:id="@+id/closeSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/control_bg"
                    android:contentDescription="Fechar"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- Cérebro de IA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ai_title"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/aiHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ai_help"
                android:textColor="@color/cyan"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/aiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ai_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/cityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/city_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/morningMusicInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/morning_music_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/exactAlarmButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:text="@string/exact_alarm"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/aiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/cyan"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/aiSaveButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:text="@string/ai_save"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/tabletSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/tablet_mode"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tablet_mode_hint"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/screenSaverSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/screen_saver"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/screen_saver_hint"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/continuousSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/continuous_mode"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/continuous_hint"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/bluetoothSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/auto_bluetooth"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/auto_bluetooth_hint"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/youtubeAppSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/youtube_in_app"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/youtube_in_app_hint"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/playerChip"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/batteryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:text="@string/battery_exempt"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/overlayButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:text="@string/grant_overlay"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mediaAccessButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:text="@string/grant_media_access"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/checkUpdateButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:text="@string/check_update"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/assistantButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:text="@string/set_assistant"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/wakeFormsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/examples"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
