<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerChip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Player: automático"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Botão central do microfone -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/micRing"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/mic_ring" />

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:layout_gravity="center"
                android:background="@drawable/mic_button_bg"
                android:contentDescription="@string/cd_mic"
                android:elevation="8dp"
                android:padding="38dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/status_idle"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:minHeight="22dp"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/replyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:minHeight="22dp"
            android:textColor="@color/cyan"
            android:textSize="16sp" />

        <!-- Música atual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/trackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nothing_playing"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/trackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/volDownButton"
                style="@style/ControlButton"
                android:contentDescription="@string/cd_vol_down"
                android:src="@drawable/ic_vol_down" />

            <ImageButton
                android:id="@+id/prevButton"
                style="@style/ControlButton"
                android:contentDescription="@string/cd_prev"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/playPauseButton"
                style="@style/ControlButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/mic_button_bg"
                android:contentDescription="@string/cd_play_pause"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/nextButton"
                style="@style/ControlButton"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_next" />

            <ImageButton
                android:id="@+id/volUpButton"
                style="@style/ControlButton"
                android:contentDescription="@string/cd_vol_up"
                android:src="@drawable/ic_vol_up" />
        </LinearLayout>

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <!-- Opções -->
        <Switch
            android:id="@+id/continuousSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/continuous_mode"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/continuous_hint"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/bluetoothSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/auto_bluetooth"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/auto_bluetooth_hint"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:text="@string/grant_overlay"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/assistantButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:text="@string/set_assistant"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/mediaAccessButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:text="@string/grant_media_access"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/examples"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
