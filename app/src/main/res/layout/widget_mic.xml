<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widgetMic"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/mic_button_bg"
        android:contentDescription="@string/widget_label"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic" />

    <TextView
        android:id="@+id/widgetToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/chip_bg"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/shortcut_listen"
        android:textColor="@color/text"
        android:textSize="12sp" />
</LinearLayout>
