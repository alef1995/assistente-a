<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="talk"
        android:shortcutLongLabel="@string/shortcut_talk"
        android:shortcutShortLabel="@string/shortcut_talk">
        <intent
            android:action="com.alef.assistentea.LISTEN"
            android:targetClass="com.alef.assistentea.service.StartActivity"
            android:targetPackage="com.alef.assistentea" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="listen_always"
        android:shortcutLongLabel="@string/shortcut_listen"
        android:shortcutShortLabel="@string/shortcut_listen">
        <intent
            android:action="com.alef.assistentea.TOGGLE_CONTINUOUS"
            android:targetClass="com.alef.assistentea.service.StartActivity"
            android:targetPackage="com.alef.assistentea" />
    </shortcut>
</shortcuts>
